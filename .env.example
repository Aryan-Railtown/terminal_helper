# Copy this file to %USERPROFILE%\.sage\.env (install.ps1 does it for you) and fill in
# the key for the provider you use. You only need ONE key. Never commit a real .env file.
# Keys set in your real environment take precedence over this file.

# Gemini (default provider; has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (provider = "openai"): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic / Claude (provider = "anthropic"): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
